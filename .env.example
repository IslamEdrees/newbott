# انسخ الملف ده باسم .env واملا القيم:  cp .env.example .env
# ملف .env عمره ما يترفع على GitHub (متسجل في .gitignore)

# ===== وضع التشغيل =====
# true  = فلوس وهمية (تجربة)    false = فلوس حقيقية
FREQTRADE__DRY_RUN=true
# قاعدة بيانات منفصلة لكل وضع. لما تحول لحقيقي خليها tradesv3.sqlite
DB_FILE=tradesv3.dryrun.sqlite
# أقصى مبلغ USDT البوت مسموحله يستخدمه (حتى لو رصيدك أكبر)
FREQTRADE__AVAILABLE_CAPITAL=50
FREQTRADE__DRY_RUN_WALLET=50

# ===== حدود الموارد (اختياري) =====
# BOT_CPUS=0.5
# BOT_MEM=700m

# ===== Binance API =====
# صلاحيات: Enable Reading + Enable Spot Trading فقط. ممنوع Withdrawals.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# ===== Telegram =====
# التوكن من @BotFather ، والـ chat id من @userinfobot
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# ===== واجهة الويب FreqUI =====
# اعمل قيم عشوائية طويلة بالأمر:  openssl rand -hex 32
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=
